# Configuração do servidor Focus — copie para .env e ajuste conforme necessário.

# Porta HTTP do servidor.
PORT=3000

# Segredo de assinatura do JWT.
# AVISO: este valor é SOMENTE-DEMO. Troque antes de qualquer uso fora da LAN de testes.
JWT_SECRET=focus-demo-secret-trocar-em-producao

# Caminho do arquivo SQLite (relativo ao diretório server/).
DB_PATH=./data/focus.db
